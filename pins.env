# Expected values for this environment, machine readable.
#
# Revised: 19 September 2026
#
# install.sh and env_check.sh both read this file, so the two cannot drift
# apart. Each value carries the reason it is what it is, in the comment above
# it. See the README for what is pinned and what is only recorded.
#
# Sourced by bash. Assignments only, no logic, no command substitution.

PINS_REVISION="2026-09-19"
ENV_NAME="ROS 2 Jazzy"

# ------------------------------------------------------------------ frozen

EXPECT_UBUNTU_VERSION="24.04"
EXPECT_ROS_DISTRO="jazzy"
EXPECT_ROS_SETUP="/opt/ros/jazzy/setup.bash"

# desktop-full is the target. The fallback is what install.sh builds up by hand
# when desktop-full is unavailable, so env_check accepts either.
EXPECT_ROS_METAPACKAGE="ros-jazzy-desktop-full"
EXPECT_ROS_METAPACKAGE_ALT="ros-jazzy-desktop"

# The Docker path binds a different host directory and mounts it at /workspace,
# so the container exports ROS2_WS and this follows it. On the host nothing
# sets ROS2_WS and the default is what install.sh builds. docker/README.md
# explains why the container binds a different directory.
EXPECT_WORKSPACE="${ROS2_WS:-${HOME}/ros2_ws}"

# The Docker path has a second overlay: the rosbot stack is built into the
# upstream image rather than into the bind-mounted workspace, so rosbot_gazebo and the
# rest live here and not under EXPECT_WORKSPACE. Empty on the native path, where
# there is no such overlay.
EXPECT_IMAGE_OVERLAY="${IMAGE_OVERLAY:-/ros2_ws/install/setup.bash}"

# Where the Husarion sources live. On the host they are cloned into the
# workspace. In the container they are already built into the image at /ros2_ws,
# which is why the container reports the sources rather than checking them.
EXPECT_HUSARION_SRC="${HUSARION_SRC:-${EXPECT_WORKSPACE}/src}"

# Husarion sources. One repository and its branch, which is what Husarion's own
# setup instructions use:
#
#   git clone -b jazzy https://github.com/husarion/rosbot_ros.git src/rosbot_ros
#   vcs import src < src/rosbot_ros/rosbot/rosbot_simulation.repos
#
# Everything else in the workspace, husarion_gz_worlds included, arrives through
# that manifest. It is not listed here, because listing it here means naming a
# second version of a package upstream already versions for us.
#
# Nothing is pinned to a commit. What a machine actually got is recorded in
# ~/.ros2-env/workspace.repos.lock at install time, which survives an
# upstream move in a way a stale SHA does not. See the README.
ROSBOT_REPO="https://github.com/husarion/rosbot_ros.git"
ROSBOT_BRANCH="jazzy"

# ------------------------------------------------- recorded, asserted loosely
#
# These layers are not frozen: packages.ros.org and the Ubuntu archive both keep
# only the current version, so asserting an exact patch level fails on every
# archive sync. The assertion width is the point, not the number.

EXPECT_GZ_MAJOR="8"            # Gazebo Harmonic
EXPECT_GXX_MAJOR="13"          # Noble default
EXPECT_CMAKE_MAJOR_MINOR="3.28"

# ------------------------------------------------------------ runtime policy

# Machines on the same LAN otherwise share a single ROS graph and drive each
# other's robots. See the discovery isolation section of docker/README.md.
EXPECT_DISCOVERY_RANGE="LOCALHOST"

# ------------------------------------------------------------------ install

# ros-apt-source normally resolves to the latest GitHub release. That call is
# unauthenticated and gets rate limited from a shared network, so this is the
# version to fall back to when it fails. Verified against a real install on
# 19 September 2026, which resolved 1.3.0 from the API. Check it against the
# releases page whenever this file is revised, because a fallback nobody checks
# only gets used on the day it is already too old.
ROS_APT_SOURCE_FALLBACK="1.3.0"

# Preflight warning thresholds. One set of numbers for every artifact that
# quotes a host spec.
MIN_RAM_GB=8
MIN_DISK_GB=30

# apt stages every .deb under /var/cache/apt/archives before unpacking it, and
# the ROS 2 metapackage is roughly 4 GB of them. Where /var is its own partition
# this runs out long before $HOME or / do, and apt reports it as a bare "no space
# left on device" in the middle of a download.
MIN_VAR_GB=6

# ---------------------------------------------------------- workspace policy
#
# Both lists are data. install.sh reads them and knows nothing about what is in
# them, so adjusting the workspace for an upstream change is an edit here, not a
# change to the script.

# rosdep keys to skip when resolving workspace dependencies. One unresolvable
# key fails the whole workspace, so a package that is genuinely unavailable has
# to be named here rather than left to break the build.
#
#   rosbot_hardware_interfaces  lives inside rosbot_ros, --ignore-src covers it
#
#   explore_lite                declared by Husarion's tutorial_pkg and not
#                               released for Jazzy at all. Only its exploration
#                               tutorial needs it; navigation and SLAM do not.
#                               Listed so that cloning tutorial_pkg into the
#                               workspace does not abort the build.
ROSDEP_SKIP_KEYS="rosbot_hardware_interfaces explore_lite"

# Packages to keep out of the workspace, as paths under src/. install.sh writes
# AMENT_IGNORE and COLCON_IGNORE into each, so rosdep does not crawl it and
# colcon does not build it.
#
# This is Husarion's own simulation-only step. Their README says "For simulation
# build only, remove hardware package: rm -rf src/rosbot_ros/rosbot_bringup",
# and docker/Dockerfile.simulation does exactly that before it runs rosdep. The
# same path is taken here, by ignoring rather than deleting so the sources stay
# readable.
#
#   rosbot_ros/rosbot_bringup
#     The hardware bringup, and what makes the workspace unresolvable on a
#     machine with only the public Jazzy repositories: it needs
#     rosbot_mavlink_bridge, which has no ros-jazzy-* package at all. The
#     simulation path never launches it. simulation.yaml reaches gz_sim and
#     spawn_robot.yaml, and from there components_description, controller, joy,
#     localization and rviz.
#
#   rosbot_ros/husarion_asset_server
#     Only rosbot_bringup runs it. It is also a vendor shim that downloads a
#     prebuilt binary at build time and checks it against a sha256 fetched from
#     the same release URL as the binary, which says the transfer was intact and
#     nothing about provenance.
#
#     It used to be unresolvable too, because husarion_asset_msgs was published
#     nowhere. Upstream now carries husarion_asset_msgs in the simulation
#     manifest, confirmed by a real install on 19 September 2026, so that half of
#     the reason has expired. The vendor-shim objection has not.
WORKSPACE_EXCLUDE_PACKAGES="rosbot_ros/rosbot_bringup rosbot_ros/husarion_asset_server"
