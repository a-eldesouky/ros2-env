# Copy this file to .env in the same directory, then edit it.
#
#   cp .env.example .env
#
# docker compose reads .env automatically. It is per machine, so it is not
# committed, and yours will not match anyone else's.

# ---------------------------------------------------------------- required

# Where your code lives on the host. This is NOT ~/ros2_ws: the native
# installer builds that directory with --symlink-install and those symlinks do
# not resolve inside a container. The entrypoint refuses to start if you point
# this at a natively built workspace.
#
# Create it once:  mkdir -p ~/ros2_ws_docker/src
WS_HOST=/home/CHANGE_ME/ros2_ws_docker

# Your own user and group id, so files you create in the container belong to you
# on the host. Get them with:  id -u  and  id -g
HOST_UID=1000
HOST_GID=1000

# ---------------------------------------------------------------- assigned

# Your DDS domain, 0 to 101. Two machines on the same LAN with the same domain
# id see each other's nodes, which is confusing at best.
ROS_DOMAIN_ID=0

# ---------------------------------------------------------------- optional

# The image name. Must match what you built or pulled. CI publishes
# ghcr.io/<owner>/ros2-env:jazzy and a dated tag beside it; a local
# `docker compose build` produces the short name below.
ROS2_IMAGE=ros2-env:jazzy

# The ros2-env repository, mounted read only so env_check.sh can run inside
# the container.
# The default is the directory above this one, which is right if you cloned the
# repository and did not move anything.
REPO_DIR=..

# Extra arguments for the simulation service, for example: headless:=true
SIM_LAUNCH_ARGS=

# Your X display. :0 is right on a normal desktop session. Check with: echo $DISPLAY
DISPLAY=:0

# ---------------------------------------------------------------- graphics
#
# Defaults are software rendering, which works on any machine. Gazebo runs at
# roughly 5 to 15 fps on a room sized world: ugly, and enough to pass every
# usable.
#
# For an NVIDIA card, install nvidia-container-toolkit on the host first, then
# set all four lines below to:
#
#   DOCKER_RUNTIME=nvidia
#   LIBGL_ALWAYS_SOFTWARE=0
#   NVIDIA_VISIBLE_DEVICES=all
#   NVIDIA_DRIVER_CAPABILITIES=all
#
# Without the toolkit installed, DOCKER_RUNTIME=nvidia fails at `up` with
# "unknown or invalid runtime name". That is the check; there is nothing else
# to configure.
DOCKER_RUNTIME=runc
LIBGL_ALWAYS_SOFTWARE=1
NVIDIA_VISIBLE_DEVICES=
NVIDIA_DRIVER_CAPABILITIES=
